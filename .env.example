# .env.example
#
# PURPOSE: A SAFE copy of .env with no real secrets, which IS uploaded to GitHub.
# A teammate copies this file, renames the copy to ".env", and fills in their own values.
# (Never put a real key in THIS file.)

# fake = pretend AI (no key needed). openai_compat = a real model (Groq, Ollama, ...)
CYBERGPT_LLM_PROVIDER=fake

# For Groq:
# CYBERGPT_LLM_PROVIDER=openai_compat
# CYBERGPT_LLM_BASE_URL=https://api.groq.com/openai/v1
# CYBERGPT_LLM_MODEL=openai/gpt-oss-120b
# CYBERGPT_LLM_API_KEY=paste-your-own-key-here

# For Ollama on your own computer:
# CYBERGPT_LLM_PROVIDER=openai_compat
# CYBERGPT_LLM_BASE_URL=http://localhost:11434/v1
# CYBERGPT_LLM_MODEL=llama3.2:3b
# CYBERGPT_LLM_API_KEY=ollama

CYBERGPT_LLM_TIMEOUT_SECONDS=120
CYBERGPT_LLM_TEMPERATURE=0.2
CYBERGPT_LLM_MAX_TOKENS=1024

# Optional shared password for the whole site. Leave empty on your own laptop.
# ALWAYS set it on the hosted copy.
# CYBERGPT_ACCESS_PASSWORD=choose-a-long-passphrase